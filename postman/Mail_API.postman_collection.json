              "mode": "raw",
              "raw": "{\n  \"subject\": \"Homework\",\n  \"body\": \"Project description.\",\n  \"recipient_address\": \"teacher@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "",
                  "var responseBody = pm.response.json();",
                  "pm.test(\"Message in our folder\", function () {",
                  "    pm.expect(responseBody.folder_id).to.eql(pm.collectionVariables.get(\"folder_id\"));",
                  "    pm.expect(responseBody.subject).to.eql(\"Homework\");",
                  "    pm.expect(responseBody.body).to.eql(\"Project description.\");",
                  "    pm.expect(responseBody.recipient_address).to.eql(\"teacher@example.com\");",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/messages/\" + responseBody.code);",
                  "});",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"message_code\", responseBody.code);"
                ]
              }
            }
          ],
          "response": []
