    {
      "name": "05. Лимит входа — задания 05–06",
      "description": "Для проверки 429 выберите только эту папку в Runner, Iterations = 11 и Delay = 0. Все попытки одного IP в текущей минуте учитываются.",
      "item": [
        {
          "name": "01. Неверный вход: повторить 11 раз через Runner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "Выберите только папку 05 в Runner, Iterations = 11, Delay = 0. Запрос проверяет 401/429, заголовки и уменьшение счётчика. Предыдущие попытки тоже учитываются. После достижения лимита ожидается 429. Если серия пересекла границу минуты, повторите её в начале нового окна.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"missing-user\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var code = pm.response.code;",
                  "var remaining = Number(pm.response.headers.get(\"X-RateLimit-Remaining\"));",
                  "var reset = Number(pm.response.headers.get(\"X-RateLimit-Reset\"));",
                  "pm.test(\"Login rejected or rate limited\", function () { pm.expect([401, 429]).to.include(code); });",
                  "pm.test(\"Rate limit headers\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-RateLimit-Limit\")).to.eql(\"10\");",
                  "    pm.expect(Number.isInteger(remaining)).to.eql(true);",
                  "    pm.expect(remaining).to.be.within(0, 9);",
                  "    pm.expect(Number.isInteger(reset) && reset > 0).to.eql(true);",
                  "});",
                  "var previousReset = Number(pm.collectionVariables.get(\"rate_reset\"));",
                  "var previousRemaining = Number(pm.collectionVariables.get(\"rate_remaining\"));",
                  "if (previousReset === reset && pm.collectionVariables.get(\"rate_remaining\") !== \"\") {",
                  "    pm.test(\"Counter and status follow previous attempt\", function () {",
                  "        pm.expect(code).to.eql(previousRemaining > 0 ? 401 : 429);",
                  "        pm.expect(remaining).to.eql(Math.max(0, previousRemaining - 1));",
                  "    });",
                  "}",
                  "if (code === 429) {",
                  "    pm.test(\"Limit exceeded\", function () {",
                  "        pm.expect(remaining).to.eql(0);",
                  "        pm.expect(pm.response.json().detail).to.eql(\"Too many login attempts\");",
                  "    });",
                  "} else {",
                  "    pm.test(\"Invalid credentials\", function () { pm.expect(pm.response.json().detail).to.be.a(\"string\"); });",
                  "}",
                  "pm.collectionVariables.set(\"rate_reset\", String(reset));",
                  "pm.collectionVariables.set(\"rate_remaining\", String(remaining));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
