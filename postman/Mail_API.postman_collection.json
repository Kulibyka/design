    {
      "name": "03. Ошибки 400, 401, 404, 409",
      "description": "Сначала выполните папку 01. Неверный вход расходует одну попытку из лимита.",
      "item": [
        {
          "name": "01. Папки без токена — 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/folders",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"JSON error detail\", function () { pm.expect(pm.response.json().detail).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02. Папки с неверным токеном — 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/folders",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
