  "item": [
    {
      "name": "01. Основной сценарий — восемь операций и вход",
      "description": "Подходит всем версиям API, начиная с задания 02. Выполняйте запросы по порядку.",
      "item": [
        {
          "name": "01. Создать пользователя",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/users",
            "description": "Начните здесь. При каждом запуске создаётся уникальный логин; переменные прошлого сценария очищаются.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"first_name\": \"Ivan\",\n  \"last_name\": \"Petrov\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"login\", \"postman_\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "[\"token\", \"user_id\", \"folder_id\", \"message_code\", \"cache_folder_id\", \"cache_message_code\",",
                  " \"other_token\", \"other_user_id\", \"other_login\", \"rate_reset\", \"rate_remaining\"].forEach(function (key) {",
                  "    pm.collectionVariables.set(key, \"\");",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "",
                  "var responseBody = pm.response.json();",
                  "pm.test(\"Public user fields\", function () {",
                  "    pm.expect(responseBody.login).to.eql(pm.collectionVariables.get(\"login\"));",
                  "    pm.expect(responseBody.first_name).to.eql(\"Ivan\");",
                  "    pm.expect(responseBody.last_name).to.eql(\"Petrov\");",
                  "    pm.expect(responseBody).not.to.have.property(\"password\");",
                  "    pm.expect(responseBody).not.to.have.property(\"password_hash\");",
                  "});",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"user_id\", responseBody.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02. Войти и сохранить токен",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "Токен автоматически сохраняется в переменную token и используется последующими запросами.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "var responseBody = pm.response.json();",
                  "pm.test(\"Bearer session\", function () {",
                  "    pm.expect(responseBody.access_token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(responseBody.token_type).to.eql(\"bearer\");",
                  "    pm.expect(responseBody.expires_in).to.eql(3600);",
                  "});",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", responseBody.access_token);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03. Найти пользователя по логину",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/users/by-login?login={{login}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "pm.test(\"Created user found\", function () {",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"user_id\"));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "04. Найти пользователей по маскам",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/users?first_name_mask=Iv%2A&last_name_mask=Pet%3Fov",
            "description": "Маски Iv* и Pet?ov соответствуют имени Ivan и фамилии Petrov."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "pm.test(\"Masks include our user\", function () {",
                  "    var responseBody = pm.response.json();",
                  "    pm.expect(responseBody).to.be.an(\"array\");",
                  "    pm.expect(responseBody.some(function (user) { return user.id === pm.collectionVariables.get(\"user_id\"); })).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
